{
  "name": "nox-freepanel-bot",
  "version": "1.0.0",
  "description": "Telegram bot for Pterodactyl panel with coin system and referrals",
  "main": "dist/bot.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/bot.js",
    "dev": "nodemon --exec ts-node src/bot.ts",
    "render-build": "npm install --legacy-peer-deps && npm run build"
  },
  "dependencies": {
    "telegraf": "^4.16.3",
    "axios": "^1.6.0",
    "mongoose": "^8.0.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "crypto": "^1.0.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "typescript": "^5.3.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1"
  },
  "engines": {
    "node": "18.x"
  }
}
