{
  "name": "nox-freepanel-bot",
  "version": "1.0.0",
  "description": "Telegram bot for Pterodactyl panel with coin system and referrals",
  "main": "dist/bot.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/bot.js",
    "dev": "nodemon --exec ts-node src/bot.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "dependencies": {
    "telegraf": "^4.16.3",
    "axios": "^1.6.0",
    "mongoose": "^8.0.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "crypto": "^1.0.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "typescript": "^5.3.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0"
  },
  "keywords": [
    "telegram",
    "bot",
    "pterodactyl",
    "coins",
    "referral",
